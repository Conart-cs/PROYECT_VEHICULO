<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="miContenedor"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.sysventas.controller.MarcaController">

    <BorderPane AnchorPane.topAnchor="0"
                AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0">

        <top>
            <HBox spacing="20"
                  alignment="CENTER_LEFT"
                  style="-fx-background-color: #1e3a5f;">

                <padding>
                    <Insets top="20"
                            right="25"
                            bottom="20"
                            left="25"/>
                </padding>

                <VBox spacing="5"
                      HBox.hgrow="ALWAYS">

                    <Label text="🏷️ GESTIÓN DE MARCAS"
                           style="-fx-text-fill: white;
                          -fx-font-size: 26px;
                          -fx-font-weight: bold;"/>

                    <Label text="Registro y administración de marcas de vehículos"
                           style="-fx-text-fill: #dbeafe;
                          -fx-font-size: 14px;"/>

                </VBox>

                <Button text="←  Volver al inicio"
                        onAction="#volverInicio"
                        prefHeight="35"
                        prefWidth="150"
                        style="-fx-background-color: #34495e;
                       -fx-text-fill: white;
                       -fx-background-radius: 6;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>

            </HBox>
        </top>

        <center>

            <HBox spacing="20">

                <padding>
                    <Insets top="25"
                            right="25"
                            bottom="25"
                            left="25"/>
                </padding>


                <!-- FORMULARIO -->
                <VBox spacing="12"
                      prefWidth="330"
                      style="-fx-background-color: white;
                             -fx-background-radius: 10;
                             -fx-padding: 20;">

                    <Label text="Registrar marca"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1e293b;"/>


                    <!-- NOMBRE -->
                    <Label text="Nombre de la marca"/>

                    <TextField fx:id="txtNombre"
                               promptText="Ingrese nombre de la marca"/>


                    <!-- COLORES -->
                    <Label text="Colores de la marca"
                           style="-fx-font-weight: bold;
                                  -fx-text-fill: #1e293b;"/>

                    <HBox spacing="8">

                        <TextField fx:id="txtColor"
                                   promptText="Ingrese un color"
                                   HBox.hgrow="ALWAYS"/>

                        <Button text="➕"
                                onAction="#agregarColor"
                                prefWidth="45"
                                style="-fx-background-color: #16a34a;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 6;"/>

                    </HBox>


                    <ListView fx:id="listaColores"
                              prefHeight="80"/>


                    <Button text="🗑️ ELIMINAR COLOR"
                            onAction="#eliminarColor"
                            maxWidth="Infinity"
                            prefHeight="32"
                            style="-fx-background-color: #dc2626;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;"/>


                    <!-- MODELOS -->
                    <Label text="Modelos de la marca"
                           style="-fx-font-weight: bold;
                                  -fx-text-fill: #1e293b;"/>

                    <HBox spacing="8">

                        <TextField fx:id="txtModelo"
                                   promptText="Ingrese un modelo"
                                   HBox.hgrow="ALWAYS"/>

                        <Button text="➕"
                                onAction="#agregarModelo"
                                prefWidth="45"
                                style="-fx-background-color: #16a34a;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 6;"/>

                    </HBox>


                    <ListView fx:id="listaModelos"
                              prefHeight="80"/>


                    <Button text="🗑️ ELIMINAR MODELO"
                            onAction="#eliminarModelo"
                            maxWidth="Infinity"
                            prefHeight="32"
                            style="-fx-background-color: #dc2626;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;"/>


                    <!-- BOTONES -->
                    <Button text="💾 GUARDAR MARCA"
                            onAction="#validarFormulario"
                            maxWidth="Infinity"
                            prefHeight="42"
                            style="-fx-background-color: #2563eb;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;"/>

                    <Button text="🧹 LIMPIAR"
                            onAction="#clearForm"
                            maxWidth="Infinity"
                            prefHeight="35"
                            style="-fx-background-color: #64748b;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;"/>


                    <Label fx:id="lbnMsg"
                           wrapText="true"
                           style="-fx-text-fill: red;
                                  -fx-font-size: 14px;"/>

                </VBox>


                <!-- TABLA -->
                <VBox spacing="15"
                      VBox.vgrow="ALWAYS"
                      HBox.hgrow="ALWAYS">

                    <HBox spacing="10">

                        <TextField fx:id="txtFiltroDato"
                                   promptText="Buscar marca..."
                                   HBox.hgrow="ALWAYS"/>

                        <Button text="Limpiar"
                                onAction="#limpiarFiltro"
                                prefWidth="90"/>

                    </HBox>


                    <Label text="Marcas registradas"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1e293b;"/>


                    <TableView fx:id="tableView"
                               VBox.vgrow="ALWAYS"/>

                </VBox>

            </HBox>

        </center>

    </BorderPane>

</AnchorPane>
